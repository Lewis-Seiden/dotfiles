// -*- mode: jsonc -*-
{
    "spacing": 0,
    "height": 0,
    "margin-bottom": 0,
    "margin-top": 0,
    "position": "top",
    "margin-right": 8,
    "margin-left": 8,
    // Choose the order of the modules
    "modules-left": [
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
	"niri/window"
    ],
    "modules-center": [
      "custom/search",
      "custom/virtual_keyboard"
    ],
    "modules-right": [
        "network",
        "battery",
        "pulseaudio",
    	"clock"
    ],
    "niri/window": {
    	"format": "<span>    {title}</span>",
    	"rewrite": {
    	}
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "cpu": {
        "format": "󰘚 {usage}%",
        "tooltip": true,
        "interval": 1,
        "on-click": "kitty -e htop"
    },
    "memory": {
        "format": "󰍛 {}%",
        "interval": 1,
        "on-click": "kitty -e htop"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "󱃃",
            "󰔏",
            "󱃂"
        ],
    },
    "clock": {
      "format": "󰅐  {:%H:%M}",
      "tooltip": false
    },
    "network": {
      "format-wifi": "   {bandwidthDownBits}",
      "format-ethernet": "   {bandwidthDownBits}",
      "format-disconnected": "󰤮  No Network",
      "interval": 5,
      "tooltip": false
    },
    "pulseaudio": {
      "scroll-step": 5,
      "max-volume": 150,
      "format": "{icon}  {volume}%",
      "format-bluetooth": "{icon}  {volume}%",
      "format-icons": [
        "",
        "",
        " "
      ],
      "nospacing": 1,
      "format-muted": " ",
      "on-click": "pavucontrol",
      "tooltip": false
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰂄{capacity}%",
      "format-alt": "{icon} {time}",
      "format-full": "󱈑 {capacity}%",
      "format-icons": [
        "󱊡",
        "󱊢",
        "󱊣"
      ]
    },
    "custom/virtual_keyboard": {
        "format": " ",
        "tooltip-format": "Virtual keyboard",
        "on-click": "sh ~/.config/waybar/control_wvkbd.sh"
    },
    "custom/search": {
      "format": " ",
      "tooltip-format": "Open Fuzzel",
      "on-click": "fuzzel"
    }
} 
