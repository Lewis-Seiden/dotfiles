// -*- mode: jsonc -*-
{
    "spacing": 0,
    "height": 0,
    "margin-bottom": 0,
    "margin-top": 0,
    "position": "top",
    "margin-right": 8,
    "margin-left": 8,
    // Choose the order of the modules
    "modules-left": [
    ],
    "modules-center": [
    ],
    "modules-right": [
        "network",
        "battery",
        "pulseaudio",
    	"clock"
    ],
    "clock": {
      "format": "󰅐  {:%H:%M}",
      "tooltip": false
    },
    "network": {
      "format-wifi": "   {bandwidthDownBits}",
      "format-ethernet": "   {bandwidthDownBits}",
      "format-disconnected": "󰤮  No Network",
      "interval": 5,
      "tooltip": false
    },
    "pulseaudio": {
      "scroll-step": 5,
      "max-volume": 150,
      "format": "{icon}  {volume}%",
      "format-bluetooth": "{icon}  {volume}%",
      "format-icons": [
        "",
        "",
        " "
      ],
      "nospacing": 1,
      "format-muted": " ",
      "on-click": "pavucontrol",
      "tooltip": false
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰂄{capacity}%",
      "format-alt": "{icon} {time}",
      "format-full": "󱈑 {capacity}%",
      "format-icons": [
        "󱊡",
        "󱊢",
        "󱊣"
      ]
    }
} 
